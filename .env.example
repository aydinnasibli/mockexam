# Copy to .env.local and fill in. Never commit real values.
#
#   cp .env.example .env.local
#
# REQUIRED vars must be set for the app to build or run. Everything marked
# OPTIONAL degrades gracefully when left empty.

# ── Database — Neon Postgres (REQUIRED) ───────────────────────────────────────
# App traffic: the POOLED endpoint (host contains `-pooler`).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Migrations (drizzle-kit, scripts/): the DIRECT endpoint, no `-pooler`.
# PgBouncer's transaction mode breaks advisory locks and DDL. Falls back to
# DATABASE_URL when unset.
DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# ── Clerk — auth (REQUIRED) ───────────────────────────────────────────────────
# https://dashboard.clerk.com. Use pk_live_/sk_live_ in production.
# The publishable key must be present at BUILD time: the CSP derives Clerk's
# Frontend API host from it, and a production build fails without it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# User-sync webhook (REQUIRED in production). Clerk Dashboard > Webhooks >
# Add Endpoint:
#   URL     https://www.testcentre.az/api/webhooks/clerk
#   Events  user.created, user.updated, user.deleted
# then copy that endpoint's Signing Secret here. Without it the route answers
# 500 and Clerk keeps retrying: users still get a row on their first write, but
# profile changes and account deletions are not applied.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ── Site URL ──────────────────────────────────────────────────────────────────
# Origin for canonicals, sitemap, OG images and payment redirect URLs.
# Local: http://localhost:3000. Production: leave unset or set to
# https://www.testcentre.az (any other value fails a Vercel production build).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Epoint.az — payments (REQUIRED for checkout) ──────────────────────────────
# epoint.az dashboard > API idarəetmə
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=

# ── OpenAI — writing evaluation (OPTIONAL) ────────────────────────────────────
# Without it, essays stay "pending" instead of being graded.
OPENAI_API_KEY=sk-...

# ── Upstash Redis — rate limiting (REQUIRED in production) ────────────────────
# Checkout, contact form, exam submission, writing re-grade.
# If unreachable, falls back to a weaker per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Contact form — Resend (OPTIONAL) ──────────────────────────────────────────
# API key: https://resend.com/api-keys (Sending access is enough).
# Without RESEND_API_KEY and CONTACT_TO the contact form shows "unavailable".
RESEND_API_KEY=re_...
# Where messages are delivered.
CONTACT_TO=
# Sender. Must be on a domain verified at https://resend.com/domains. Defaults
# to Resend's onboarding@resend.dev, which only delivers to the address that
# owns the Resend account — fine for testing, not for production.
CONTACT_FROM=Testcentre əlaqə <contact@testcentre.az>

# ── PostHog — analytics + error tracking (OPTIONAL) ───────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Source-map upload at build time. Without both, the upload is skipped and
# stack traces stay minified.
#   Personal API key (phx_, NOT the phc_ project key), scope error_tracking:write:
#     https://eu.posthog.com/settings/user-api-keys
#   Project ID: the number in eu.posthog.com/project/<PROJECT_ID>/...
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Vercel Cron (REQUIRED in production) ──────────────────────────────────────
# Bearer token Vercel sends to /api/cron/sweep. The route returns 500 without it.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── IndexNow — push URL changes to Bing/Yandex (OPTIONAL) ─────────────────────
# 8–128 chars, [A-Za-z0-9-]. Served publicly at /indexnow-key.txt, so it's not
# a secret. Unset disables submissions.
# Generate: openssl rand -hex 16
INDEXNOW_KEY=

# ── Promotions ────────────────────────────────────────────────────────────────
# First exam free for new users. Only the exact string "true" enables it;
# anything else, including unset, means OFF.
FIRST_EXAM_FREE=false
