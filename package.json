{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@neondatabase/serverless": "^1.1.0",
    "@posthog/next": "^0.8.4",
    "@posthog/nextjs-config": "^1.9.68",
    "@posthog/react": "^1.10.3",
    "@tailwindcss/forms": "^0.5.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "posthog-js": "^1.415.1",
    "posthog-node": "^5.48.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "mongodb": "^7.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.18",
    "brace-expansion@<1.1.17": "^1.1.18"
  },
  "allowScripts": {
    "@posthog/cli@0.7.34": true
  }
}
